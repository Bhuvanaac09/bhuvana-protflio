{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/resume",
      "destination": "/files/Bhuvaneshwari-C-Resume.pdf"
    },
    {
      "source": "/health",
      "destination": "/health.json"
    }
  ],
  "headers": [
    {
      "source": "/resume",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Bhuvaneshwari-C-Resume.pdf\""
        }
      ]
    },
    {
      "source": "/files/Bhuvaneshwari-C-Resume.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Bhuvaneshwari-C-Resume.pdf\""
        }
      ]
    }
  ]
}
